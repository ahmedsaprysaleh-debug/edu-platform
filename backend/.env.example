# قاعدة البيانات
MONGO_URI=mongodb://localhost:27017/edu-platform

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# السيرفر
PORT=5000
CLIENT_URL=http://localhost:5173

# ================================
# Paymob (بوابة الدفع - بتدعم فودافون كاش وانستا باي وبطاقات)
# سجل حساب على https://paymob.com واحصل على القيم دي من الداشبورد
# ================================
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_INTEGRATION_ID_WALLET=your_wallet_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# ================================
# إرسال الإيميلات (نسيت الباسورد) - جرب Gmail App Password أو خدمة زي SendGrid/Mailgun
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
